NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_PUBLICA

# TURN dedicado (Xirsys) — já não é usado depois da migração para
# Daily.co, mas fica aqui sem problema caso queiras voltar atrás.
XIRSYS_IDENT=
XIRSYS_SECRET=
XIRSYS_CHANNEL=Tilawah

# Agora.io — App ID é público (o cliente precisa dele para entrar num
# canal), mas o App Certificate é secreto: só o servidor
# (app/api/agora-token) o usa para assinar tokens de entrada.
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
